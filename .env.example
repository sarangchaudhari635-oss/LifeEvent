# ==============================================================================
# LIFEEVENT AI — MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# 1. Server & Security
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://paytm-lifeevent-ai.vercel.app,https://lifeevent.ai
API_SECRET_KEY=change_this_to_a_random_32_byte_hex_string_in_production

# 2. Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_REASONING=gemini-2.0-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# 3. Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
SUPABASE_DOCUMENTS_BUCKET=patient-records
PRESIGNED_URL_EXPIRATION_SECONDS=900

# 4. Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_LOCALE=en

# 5. Security & Rate Limiting
RATE_LIMIT_INTAKE=30/minute
RATE_LIMIT_MUTATING=60/minute
APPROVAL_TOKEN_TTL_MINUTES=15

# 6. Provider Modes & Sandboxes
PROVIDER_MODE=simulated
PAYTM_MID=YOUR_PAYTM_STAGE_MID
PAYTM_MERCHANT_KEY=YOUR_PAYTM_STAGE_MERCHANT_KEY
PAYTM_WEBSITE=WEBSTAGING
PAYTM_INDUSTRY_TYPE_ID=Retail
PAYTM_CHANNEL_ID=WEB
PAYTM_CALLBACK_URL=http://localhost:8000/api/payments/paytm/callback
SETU_AA_CLIENT_ID=YOUR_SETU_AA_CLIENT_ID
SETU_AA_SECRET=YOUR_SETU_AA_SECRET
DIGILOCKER_CLIENT_ID=YOUR_DIGILOCKER_CLIENT_ID
DIGILOCKER_CLIENT_SECRET=YOUR_DIGILOCKER_CLIENT_SECRET

